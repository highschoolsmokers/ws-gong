{
  "name": "ws-gong",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --test --experimental-strip-types \"lib/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "prepare": "husky",
    "sync:resume": "node --env-file-if-exists=.env.local scripts/sync-resume.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,md,json}": "prettier --write",
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.78.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/blob": "^2.9.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "imapflow": "^1.7.8",
    "lint-staged": "^15.5.2",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
